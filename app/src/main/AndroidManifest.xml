<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Manifest for Swift Ride Application
    
    This manifest defines the application configuration, permissions, and activities.
    
    Required Permissions:
    - ACCESS_FINE_LOCATION: For precise GPS location tracking
    - ACCESS_COARSE_LOCATION: For approximate location services
    - INTERNET: For Firebase and Google Maps API connectivity
    
    Application Features:
    - Google Maps integration for driver tracking
    - Firebase authentication and database
    - Real-time location services
    - Navigation and ride management
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location permissions for GPS tracking -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    
    <!-- Internet permission for Firebase and Maps API -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Application configuration -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwiftRide"
        tools:targetApi="31">
        
        <!-- Google Maps API key for map functionality -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBt2-fYTHTDZYdXMQ7CH7Ho35To3h1OhuY"/>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".RoleSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterCommuterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing|stateHidden" />
        <activity
            android:name=".RegisterDriverActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing|stateHidden" />
        <activity
            android:name=".ProfileCommuterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing|stateHidden" />
        <activity
            android:name=".ProfileDriverActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".HomeCommuterActivity"
            android:exported="false" />
        <activity
            android:name=".DashboardDriverActivity"
            android:exported="false" />
        <activity
            android:name=".RideHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".RideInProgressActivity"
            android:exported="false" />
        <activity
            android:name=".CommuterRideProgressActivity"
            android:exported="false" />
        <activity
            android:name=".DatabaseCleanupActivity"
            android:exported="false" />
    </application>

</manifest>