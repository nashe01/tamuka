<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:padding="24dp"
  tools:context=".ui.onboarding.Onboarding1Activity">

  <TextView
    android:id="@+id/tvTitle1"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Welcome to Swift Ride"
    android:textSize="24sp"
    android:textStyle="bold"
    android:layout_marginTop="35dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_goneMarginTop="24dp" />

  <ImageView
    android:id="@+id/ivIllustration1"
    android:layout_width="300dp"
    android:layout_height="400dp"
    android:layout_marginTop="24dp"
    android:contentDescription="Illustration"
    android:scaleType="centerInside"
    android:src="@drawable/onboarding1"
    app:layout_constraintTop_toBottomOf="@id/tvTitle1"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

  <TextView
    android:id="@+id/tvDescription1"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="80dp"
    android:text="Experience seamless transportation with Swift Ride. Whether you're looking for a ride or want to earn by driving."
    android:textAlignment="center"
    android:textSize="16sp"
    android:lineSpacingExtra="4dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/ivIllustration1"
    app:layout_constraintBottom_toTopOf="@id/groupButtons1" />

  <LinearLayout
    android:id="@+id/groupButtons1"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:layout_marginTop="48dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="parent">

    <Button
      android:id="@+id/btnSkip1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="Skip" />

    <Space
      android:layout_width="16dp"
      android:layout_height="0dp" />

    <Button
      android:id="@+id/btnNext1"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="Next" />
  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>






